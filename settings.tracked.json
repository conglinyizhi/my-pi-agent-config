{
  "defaultTools": [
    "+codemode"
  ],
  "externalEditor": "kate --block",
  "npmCommand": [
    "pnpm",
    "install",
    "--ignore-scripts"
  ],
  "promptSections": true,
  "retry": {
    "enabled": true,
    "maxRetries": 10,
    "baseDelayMs": 1000
  },
  "sandboxExempt": [],
  "shellPath": "~/.pi/agent/scripts/sandbox-shell.mjs",
  "theme": "dark",
  "tuiMode": "fullscreen"
}
