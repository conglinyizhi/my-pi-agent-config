{
  "externalEditor": "kate --block",
  "npmCommand": [
    "pnpm",
    "install",
    "--ignore-scripts"
  ],
  "packages": [
    "npm:pi-mcp-adapter"
  ],
  "promptSections": true,
  "retry": {
    "enabled": true,
    "maxRetries": 10,
    "baseDelayMs": 1000
  },
  "theme": "dark",
  "shellPath": "~/.pi/agent/scripts/sandbox-shell.mjs",
  "sandboxExempt": []
}