{
  "_说明": "敏感路径黑名单（sandbox-guard 扩展在初始化/reload 时读取）。",
  "_格式": "glob 模式数组，~ 展开为 home；支持 ** 递归、* 单段通配、? 单字符。",
  "_拦截": "read/write/edit 工具的目标路径与 bash 命令中引用的路径命中任一模式即拒绝。",
  "blacklist": [
    "~/.ssh/**",
    "~/.aws/**",
    "~/.gnupg/**",
    "~/.config/gh/**",
    "~/.config/google-chrome/**",
    "~/.config/chromium/**",
    "~/.config/microsoft-edge/**",
    "~/.config/BraveSoftware/**",
    "~/.mozilla/**",
    "~/.npmrc",
    "~/.bash_history",
    "~/.zsh_history",
    "~/.pi/agent/auth.json",
    "~/.pi/agent/providers.toml",
    "~/.pi/agent/mcp-cache.json",
    ".env",
    ".env.local",
    "**/.env",
    "**/.env.local"
  ]
}
