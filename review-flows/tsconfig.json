{
	// 给编辑器用的：让 review-flows 里的流程有类型提示与检查。
	// 跑法：make flows-check（或者 npx tsc -p review-flows）
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["*.ts"]
}
